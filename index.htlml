<div class="product-bottom">

<div class="price">10 €</div>

<a
class="order"
href="mailto:mateo.toms@icloud.com?subject=Commande%20-%20Support%20souris"
>
Commander
</a>

</div>

</div>

</div>


<!-- MINI FIGURINE -->

<div class="product">

<img
src="mini-figurine.jpg"
alt="Mini figurine lapin 3D"
class="product-image"
>

<div class="product-content">

<h3>🐰 Mini figurine</h3>

